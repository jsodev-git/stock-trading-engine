# DB (Backend와 동일한 PostgreSQL 사용)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_trading
DB_USER=postgres
DB_PASSWORD=localdev123

# Backend 연동
BACKEND_URL=http://localhost:8080
INTERNAL_API_KEY=local-dev-internal-api-key-12345

# 엔진 모드
# - LIVE:  실거래 계좌 대상으로 동작 (매매 실행)
# - PAPER: 모의투자 계좌 대상
# - DRY:   주문 미실행 (로그만)
ENGINE_MODE=DRY

# 기본 시장 (KR / US). 초기엔 KR만 구현
MARKET=KR
